{
  "name": "tauri-plugin-tpk-api",
  "version": "0.1.0",
  "description": "Open-source OTA frontend updates for Tauri v2 apps. Self-hosted, signed bundles, auto-rollback, runtime channels.",
  "license": "MIT OR Apache-2.0",
  "author": "ChasLui",
  "homepage": "https://github.com/ChasLui/tauri-plugin-tpk",
  "bugs": {
    "url": "https://github.com/ChasLui/tauri-plugin-tpk/issues"
  },
  "keywords": ["tauri", "tauri-plugin", "tpk", "ota", "update", "hot-reload"],
  "repository": {
    "type": "git",
    "url": "https://github.com/ChasLui/tauri-plugin-tpk",
    "directory": "packages/tauri-plugin-tpk-api"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --platform neutral --dts --clean",
    "prepublishOnly": "cp ../../README.md . && pnpm build"
  },
  "peerDependencies": {
    "@tauri-apps/api": ">=2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
