{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "tpk-example",
  "version": "0.1.0",
  "identifier": "com.example.tpk",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "TPK Example",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "tpk": {
      "manifest_url": "https://cdn.example.com/tpk/{{channel}}/latest.json",
      "pubkeys": [
        {
          "key": "REPLACE_WITH_YOUR_PUBKEY",
          "epoch": 1
        }
      ],
      "channel": "stable"
    }
  }
}
